using "ui/basic.style";
using "ui/layers/layers.style";
using "ui/widgets/widgets.style";
using "info/info.style";

centeredBoxLabelStyle: TextStyle(boxLabelStyle) {
    font: font(13px);
    lineHeight: 0px;
}

centeredBoxLabel: FlatLabel(defaultFlatLabel) {
	minWidth: 256px;
	align: align(center);
	style: centeredBoxLabelStyle;
}

furryHeaderLogoSize: 76px;
furryHeaderGap: 18px;
furryHeaderTextGap: 4px;
furryHeaderPadding: margins(22px, 18px, 22px, 18px);

furryHeaderTitleStyle: TextStyle(boxLabelStyle) {
	font: font(18px semibold);
	lineHeight: 0px;
}
furryHeaderTitle: FlatLabel(defaultFlatLabel) {
	style: furryHeaderTitleStyle;
	textFg: windowBoldFg;
}

furryHeaderVersionStyle: TextStyle(boxLabelStyle) {
	font: font(12px semibold);
	lineHeight: 0px;
}
furryHeaderVersion: FlatLabel(defaultFlatLabel) {
	style: furryHeaderVersionStyle;
	textFg: windowActiveTextFg;
}

furryHeaderDescStyle: TextStyle(boxLabelStyle) {
	font: font(13px);
	lineHeight: 0px;
}
furryHeaderDesc: FlatLabel(defaultFlatLabel) {
	style: furryHeaderDescStyle;
	textFg: windowSubTextFg;
}

filtersAddIcon: IconButton(infoLayerTopBarClose) {
	width: 40px;
	icon: icon {{ "menu/add", boxTitleCloseFg }};
	iconOver: icon {{ "menu/add", boxTitleCloseFgOver }};
	iconPosition: point(8px, -1px);
}

filtersExcludeIcon: IconButton(infoLayerTopBarClose) {
	width: 40px;
	icon: icon {{ "menu/tag_remove", boxTitleCloseFg }};
	iconOver: icon {{ "menu/tag_remove", boxTitleCloseFgOver }};
	iconPosition: point(8px, -1px);
}
